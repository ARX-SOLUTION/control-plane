# App
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/control_plane
AUDIT_DATABASE_URL=postgresql://audit_writer:audit_writer_password@localhost:5432/control_plane_audit

# Redis
REDIS_URL=redis://localhost:6379

# Session
SESSION_SECRET=your_session_secret_must_be_at_least_32_characters_long_here
SESSION_NAME=control_plane_sid
SESSION_MAX_AGE=86400000

# Crypto (generate with: openssl rand -hex 32)
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Admin bootstrap (optional)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Docker
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Caddy
CADDY_ADMIN_URL=http://localhost:2019

# Cloudflare (optional)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# RabbitMQ (optional)
RABBITMQ_URL=amqp://admin:admin@localhost:5672

# Loki (optional)
LOKI_URL=http://localhost:3100

# Prometheus (optional)
PROMETHEUS_URL=http://localhost:9090

# OpenTelemetry (optional)
OTLP_ENDPOINT=http://localhost:4317