# App
NODE_ENV=production
PORT=3000

# Database — main
DATABASE_URL=postgresql://cp_user:CHANGE_ME@postgres:5432/control_plane
POSTGRES_USER=cp_user
POSTGRES_PASSWORD=CHANGE_ME

# Database — audit
AUDIT_DATABASE_URL=postgresql://cp_audit_user:CHANGE_ME@postgres-audit:5432/control_plane_audit
POSTGRES_AUDIT_USER=cp_audit_user
POSTGRES_AUDIT_PASSWORD=CHANGE_ME

# Redis
REDIS_URL=redis://redis:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Session (generate: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME_32_BYTES_HEX
SESSION_NAME=cp_sid
SESSION_MAX_AGE=86400000

# Crypto master key (generate: openssl rand -hex 32)
MASTER_KEY=CHANGE_ME_64_HEX_CHARS

# Admin bootstrap (only used on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_MIN_8

# Server
SERVER_IP=1.2.3.4

# Caddy (set in Caddyfile via env)
ACME_EMAIL=admin@example.com
CONTROL_PLANE_DOMAIN=cp.example.com

# Cloudflare DNS (optional)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Observability (optional)
LOKI_URL=
PROMETHEUS_URL=
OTLP_ENDPOINT=

# Grafana (optional)
GRAFANA_URL=
GRAFANA_DEPLOYMENT_DASHBOARD=
GRAFANA_METRICS_DASHBOARD=

# Notifications — SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=control-plane <noreply@example.com>

# Notifications — Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notifications — webhook (optional)
NOTIFICATION_WEBHOOK_URL=
