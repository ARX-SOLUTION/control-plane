	admin 0.0.0.0:2019
	email {$ACME_EMAIL}
}

{$CONTROL_PLANE_DOMAIN} {
	# API va WebSocket → NestJS backend
	handle /api/* {
		reverse_proxy app:3000
	}

	handle /ws* {
		reverse_proxy app:3000
	}

	# Frontend static files
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
